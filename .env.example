# wenbi environment variables
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# DeepL API key for translation
DEEPL_API_KEY=your_deepl_api_key_here

# Google API key for Gemini models and services
GOOGLE_API_KEY=your_google_api_key_here

# Google API key (JSON format, used as fallback)
GOOGLE_API_KEY_JSON=your_google_api_key_json_here

# Hugging Face token for pyannote audio models
HUGGINGFACE_TOKEN=your_huggingface_token_here

# OpenAI API key (set by openai library automatically)
OPENAI_API_KEY=your_openai_api_key_here

# DSPy cache directory (optional, defaults to .dspy_cache)
# DSPY_CACHEDIR=/path/to/dspy/cache